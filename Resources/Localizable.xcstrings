      }
    },
    "Reads the login Claude Code keeps in the Keychain and calls an undocumented endpoint. It adds per-model limits, but Anthropic's terms restrict using subscription logins in other tools. Use at your own risk." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lê o login que o Claude Code guarda nas Chaves e chama um endpoint não documentado. Mostra limites por modelo, mas os termos da Anthropic restringem o uso de logins de assinatura em outras ferramentas. Use por sua conta e risco."
          }
