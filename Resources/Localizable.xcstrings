          }
        }
      }
    },
    "Checking…" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificando…"
          }
        }
      }
    },
    "Claude Code passes your plan limits to its status line. Usage AI adds a small script there that saves them and keeps your current status line. Usage updates while you use Claude Code. Per-model limits, such as Fable, need the OAuth source." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Claude Code envia os limites do seu plano para a status line. O Usage AI adiciona ali um pequeno script que salva esses dados e mantém sua status line atual. O uso é atualizado enquanto você usa o Claude Code. Limites por modelo, como o do Fable, exigem a fonte OAuth."
          }
        }
      }
    },
    "Claude Code status line" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Status line do Claude Code"
          }
        }
      }
    },
    "Claude Code's login expired. Run `claude` in Terminal to refresh it." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O login do Claude Code expirou. Rode `claude` no Terminal para renová-lo."
          }
        }
      }
    },
    "Claude and Cursor usage comes from undocumented endpoints and files that can change at any time. Usage AI is not affiliated with Anthropic, Anysphere or OpenAI." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O uso do Claude e do Cursor vem de endpoints e arquivos não documentados, que podem mudar a qualquer momento. O Usage AI não tem vínculo com a Anthropic, a Anysphere ou a OpenAI."
          }
        }
      }
    },
    "Connect" : {
      "localizations" : {
